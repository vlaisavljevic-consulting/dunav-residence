// Prisma schema — multi-tenant osnova (BIZNIS_PLAN.md sekcija 6).
// Jedna aplikacija, više klijent-projekata; svaki Project bira Template.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum PurchasePurpose {
  OWN_USE
  INVESTMENT
  UNKNOWN
}

// Vizuelna tema koju projekat koristi (sekcija 6: "sistem template-a").
model Template {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  projects  Project[]
}

// Investitor (developer) — jedna firma može imati više projekata.
model Developer {
  id        String    @id @default(cuid())
  name      String
  mb        String? // matični broj
  pib       String? // PIB
  address   String?
  phone     String?
  email     String?
  createdAt DateTime  @default(now())
  projects  Project[]
}

// Jedan klijent-projekat = jedan mikrosajt (BIZNIS_PLAN.md sekcija 7, Tier 1).
model Project {
  id          String   @id @default(cuid())
  slug        String   @unique // npr. "dunav-residence"
  domain      String? // custom domen kad klijent plati
  name        String
  tagline     String?
  heroImage   String?
  location    String?
  description String?

  totalVillas    Int?
  totalUnits     Int?
  totalCommercial Int?
  totalParking   Int?
  grossAreaM2    Float?

  completionDate DateTime?
  permitStatus   String?

  developerId String
  developer   Developer @relation(fields: [developerId], references: [id])

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id])

  unitTypes UnitType[]
  units     Unit[]
  leads     Lead[]
  posts     Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tip stana (npr. "Prizemlje", "Sprat", "Potkrovni dupleks").
model UnitType {
  id            String  @id @default(cuid())
  name          String
  description   String?
  planImage2d   String?
  planImage3d   String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  units Unit[]

  createdAt DateTime @default(now())
}

// Pojedinačni stan — "živi" podatak, srž AvailabilityTable komponente.
model Unit {
  id     String     @id @default(cuid())
  code   String // oznaka stana, npr. "Vila 4 / Prizemlje"
  floor  String?
  areaM2 Float?
  price  Float?
  status UnitStatus @default(AVAILABLE)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  unitTypeId String?
  unitType   UnitType? @relation(fields: [unitTypeId], references: [id])

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, code])
}

// Upit sa kontakt forme — BIZNIS_PLAN.md sekcija 6 (lead capture).
model Lead {
  id      String          @id @default(cuid())
  name    String
  email   String?
  phone   String?
  message String?
  purpose PurchasePurpose @default(UNKNOWN)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])

  createdAt DateTime @default(now())
}

// Blog post (BIZNIS_PLAN.md/PILOT sekcija 5 — mini prodajni blog).
model Post {
  id        String   @id @default(cuid())
  slug      String
  title     String
  excerpt   String?
  content   String
  published Boolean  @default(false)

  projectId String
  project   Project  @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
}
